  "registry_format": 1,
  "repair_classes": [
    { "name": "rename-binding", "summary": "rename the colliding binder named in the diagnostic" },
    { "name": "qualify-name", "summary": "use the Type::Ctor / module::def spelling (a collision exists)" },
    { "name": "unqualify-name", "summary": "drop the needless qualification (the name is unique)" },
    { "name": "widen-match", "summary": "add the missing arm; the witness note names it" },
    { "name": "remove-redundant-arm", "summary": "delete the arm that can never match" },
    { "name": "add-record-rest", "summary": "add `..` to the partial record pattern" },
    { "name": "add-annotation", "summary": "annotate so the type is monomorphic at this site" },
    { "name": "fix-type", "summary": "reconcile the term with the declared types" },
    { "name": "thread-capability", "summary": "pass the capability and widen the declared row to cover the callee's io/ffi" },
    { "name": "fix-literal", "summary": "bring the literal into its resolved width's range" },
    { "name": "insert-guard", "summary": "match or guard the panicking case away" },
    { "name": "add-decreases", "summary": "supply the decreasing argument or measure" },
    { "name": "export-type-or-mark-abstract", "summary": "export the referenced type or mark it abstract" },
    { "name": "fill-hole", "summary": "replace the typed hole with a term at its goal type" },
    { "name": "fix-spec", "summary": "the spec itself must change; if the block is pinned, ask_human" },
    { "name": "fix-config", "summary": "an environment, configuration, or lock problem for the human to fix" }
